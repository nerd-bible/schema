{
	"name": "@nerd-bible/schema",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json",
		"watch": "npm run build -- --watch",
		"test": "node --test",
		"fmt": "prettier --check --ignore-path .gitignore .",
		"fmt-fix": "npm run fmt -- --write"
	},
	"dependencies": {
		"@nerd-bible/ref": "^0.1.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nerd-bible/config": "^0.3.0",
		"wordgard": "npm:@nerd-bible/wordgard@^0.6.2-beta3"
	},
	"peerDependencies": {
		"wordgard": "*"
	},
	"prettier": "@nerd-bible/config/prettier"
}
